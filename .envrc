# direnv runs this file automatically when you cd into the project.
# It keeps your Python environment in sync without manual activation.
#
# One-time setup: run `make setup` (or `direnv allow .`) to approve this file.
# Install direnv: https://direnv.net/docs/installation.html

watch_file uv.lock         # re-run this file whenever uv.lock changes (e.g. after git pull)
uv sync --frozen           # --frozen prevents uv from modifying uv.lock, avoiding dirty-tree issues when switching branches
source .venv/bin/activate  # activate the uv-managed venv
