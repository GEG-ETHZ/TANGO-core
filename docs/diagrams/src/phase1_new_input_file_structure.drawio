<mxfile host="app.diagrams.net">
  <diagram name="New Input File Structure" id="phase1-input-file">
    <mxGraphModel dx="1034" dy="546" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Phase 1 — Desired Input File Structure: flexible_SF_manual.yml (new schema)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="15" width="1040" height="28" as="geometry" />
        </mxCell>

        <!-- LEFT: Old structure summary -->
        <mxCell id="lhdr" value="BEFORE  (current structure)" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="55" width="330" height="28" as="geometry" />
        </mxCell>

        <mxCell id="old_block" value="graph:&lt;br&gt;  nodes:&lt;br&gt;    injection_well: {type, unit}  &lt;i&gt;# stub only&lt;/i&gt;&lt;br&gt;    reservoir: {type, unit}&lt;br&gt;    production_well_lower: {type, unit}&lt;br&gt;    production_well_upper: {type, unit}&lt;br&gt;    surface: {type, unit}&lt;br&gt;  edges:&lt;br&gt;    1: {source: surface, target: injection_well}&lt;br&gt;    2: {source: injection_well, target: reservoir}&lt;br&gt;    3: {source: reservoir, target: production_well_lower}&lt;br&gt;    4: {source: production_well_lower, target: production_well_upper}&lt;br&gt;    5: {source: production_well_upper, target: surface}&lt;br&gt;&lt;br&gt;props: {fluid_name, densities, ...}&lt;br&gt;surface: {temperature, pressures, ...}&lt;br&gt;injection_well: {length, diameter, ...}&lt;br&gt;reservoir: {depth, permeability, ...}&lt;br&gt;production_well: {length, ...}&lt;br&gt;production_well_pump: {length, ...}&lt;br&gt;schedule: {mass_flow_rate, time, ...}&lt;br&gt;costs: {...}    economic: {...}&lt;br&gt;power_plant_graph: {nodes, edges}&lt;br&gt;valve: {...}  turbine: {...}  condenser: {...}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="20" y="93" width="330" height="370" as="geometry" />
        </mxCell>

        <mxCell id="prob1" value="⚠  Nodes contain only lookup keys — parameters live at root" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="20" y="475" width="340" height="18" as="geometry" />
        </mxCell>
        <mxCell id="prob2" value="⚠  Two separate graphs (main + power plant) with data mixed at root" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="20" y="496" width="340" height="18" as="geometry" />
        </mxCell>
        <mxCell id="prob3" value="⚠  Code object structure diverges from input structure" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="20" y="517" width="340" height="18" as="geometry" />
        </mxCell>

        <!-- Arrow -->
        <mxCell id="arrow" value="Phase 1&lt;br&gt;migration&lt;br&gt;tool →" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontStyle=1;fontColor=#2d7a2d;" vertex="1" parent="1">
          <mxGeometry x="355" y="270" width="90" height="60" as="geometry" />
        </mxCell>

        <!-- RIGHT: New structure -->
        <mxCell id="rhdr" value="AFTER  (Phase 1 target — each component fully self-contained)" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="455" y="55" width="625" height="28" as="geometry" />
        </mxCell>

        <!-- Top-level config (non-component) -->
        <mxCell id="new_top" value="runspec:&lt;br&gt;  title: &apos;Hydrothermal SF system&apos;&lt;br&gt;  workflow: native&lt;br&gt;&lt;br&gt;common:  &lt;i&gt;# shared physical properties&lt;/i&gt;&lt;br&gt;  fluid_name: H2O&lt;br&gt;  brine_density: 1000&lt;br&gt;  thermal_gradient: 0.035&lt;br&gt;&lt;br&gt;schedule:&lt;br&gt;  mass_flow_rate: 50.0&lt;br&gt;  well_pattern: DOUBLET&lt;br&gt;  time: {type: ConstantDT, ...}&lt;br&gt;&lt;br&gt;economic:&lt;br&gt;  type: native&lt;br&gt;  discount_rate: 0.095" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="455" y="93" width="260" height="255" as="geometry" />
        </mxCell>

        <!-- components header -->
        <mxCell id="comp_hdr" value="components:  &lt;i&gt;# each component owns all its data + graph links&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="455" y="360" width="530" height="18" as="geometry" />
        </mxCell>

        <!-- injection_well component -->
        <mxCell id="new_iw" value="  injection_well:&lt;br&gt;    type: injection_well&lt;br&gt;    unit: native&lt;br&gt;    link_index: 1&lt;br&gt;    prev_link_index: 5  &lt;i&gt;# ← from surface&lt;/i&gt;&lt;br&gt;    next_link_index: 2  &lt;i&gt;# → to reservoir&lt;/i&gt;&lt;br&gt;    well_length: 5000.0&lt;br&gt;    diameter: 0.41&lt;br&gt;    epsilon: 55.e-6&lt;br&gt;    well_length_seq: [5000.]&lt;br&gt;    well_diameter_seq: [0.41]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="455" y="386" width="285" height="180" as="geometry" />
        </mxCell>

        <!-- reservoir component -->
        <mxCell id="new_r" value="  reservoir:&lt;br&gt;    type: reservoir&lt;br&gt;    unit: native&lt;br&gt;    link_index: 2&lt;br&gt;    prev_link_index: 1&lt;br&gt;    next_link_index: 3&lt;br&gt;    reservoir_depth: 5000.0&lt;br&gt;    thickness: 300.0&lt;br&gt;    permeability: 5.0e-14&lt;br&gt;    porosity: 0.1&lt;br&gt;    hydro_static_pressure: 50e6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="750" y="93" width="285" height="175" as="geometry" />
        </mxCell>

        <!-- production_well_lower component -->
        <mxCell id="new_pwl" value="  production_well_lower:&lt;br&gt;    type: production_well&lt;br&gt;    unit: native&lt;br&gt;    link_index: 3&lt;br&gt;    prev_link_index: 2&lt;br&gt;    next_link_index: 4&lt;br&gt;    well_length: 4000.0&lt;br&gt;    diameter: 0.41&lt;br&gt;    epsilon: 55.e-6&lt;br&gt;    well_length_seq: [5000.]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="750" y="280" width="285" height="165" as="geometry" />
        </mxCell>

        <!-- surface component (with nested power plant) -->
        <mxCell id="new_s" value="  surface:&lt;br&gt;    type: surface&lt;br&gt;    unit: native_flexible&lt;br&gt;    link_index: 5&lt;br&gt;    prev_link_index: 4&lt;br&gt;    next_link_index: 1  &lt;i&gt;# closes the loop&lt;/i&gt;&lt;br&gt;    surface_temperature: 288&lt;br&gt;    pipe_diameter: 0.41&lt;br&gt;    ...&lt;br&gt;    power_plant:  &lt;i&gt;# nested sub-graph&lt;/i&gt;&lt;br&gt;      inlet:   {link_index: 0, type: Source, ...}&lt;br&gt;      valve:   {link_index: 1, p_out: 0.5}&lt;br&gt;      turbine: {link_index: 4, efficiency: 1.0, ...}&lt;br&gt;      condenser: {link_index: 5, p_out: 0.05, ...}&lt;br&gt;      ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="455" y="580" width="285" height="245" as="geometry" />
        </mxCell>

        <!-- production_well_upper -->
        <mxCell id="new_pwu" value="  production_well_upper:&lt;br&gt;    type: production_well_pump&lt;br&gt;    unit: native&lt;br&gt;    link_index: 4&lt;br&gt;    prev_link_index: 3&lt;br&gt;    next_link_index: 5&lt;br&gt;    well_length: 1000.0&lt;br&gt;    diameter: 0.41&lt;br&gt;    epsilon: 55.e-6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="750" y="460" width="285" height="155" as="geometry" />
        </mxCell>

        <!-- Improvements callout -->
        <mxCell id="imp_hdr" value="Key improvements" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=1;fontColor=#2d7a2d;" vertex="1" parent="1">
          <mxGeometry x="750" y="630" width="200" height="18" as="geometry" />
        </mxCell>
        <mxCell id="imp1" value="✓  Every component owns all its own parameters + graph link indices" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#2d7a2d;" vertex="1" parent="1">
          <mxGeometry x="750" y="650" width="330" height="18" as="geometry" />
        </mxCell>
        <mxCell id="imp2" value="✓  No separate edge dict — topology encoded per component" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#2d7a2d;" vertex="1" parent="1">
          <mxGeometry x="750" y="670" width="330" height="18" as="geometry" />
        </mxCell>
        <mxCell id="imp3" value="✓  Power plant nested inside surface (physical hierarchy)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#2d7a2d;" vertex="1" parent="1">
          <mxGeometry x="750" y="690" width="330" height="18" as="geometry" />
        </mxCell>
        <mxCell id="imp4" value="✓  Code object structure mirrors input structure exactly" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#2d7a2d;" vertex="1" parent="1">
          <mxGeometry x="750" y="710" width="330" height="18" as="geometry" />
        </mxCell>
        <mxCell id="imp5" value="✓  Only non-component config at top level (runspec, common, schedule)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#2d7a2d;" vertex="1" parent="1">
          <mxGeometry x="750" y="730" width="330" height="18" as="geometry" />
        </mxCell>
        <mxCell id="imp6" value="✓  Indices arbitrary but consistent from a fixed start (0 = BC checkpoint)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#2d7a2d;" vertex="1" parent="1">
          <mxGeometry x="750" y="750" width="330" height="18" as="geometry" />
        </mxCell>

        <!-- Migration note -->
        <mxCell id="migr" value="One-way migration tool converts old format → new. Old files kept as reference." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="455" y="800" width="625" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
