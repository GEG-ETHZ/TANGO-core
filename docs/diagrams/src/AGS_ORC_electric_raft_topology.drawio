      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=15;fontStyle=1" value="AGS_ORC_electric_raft.yml — RAFT subsurface (grouped_subsurface, variant raft) and binary (ORC) surface plant" vertex="1"><mxGeometry height="24" width="1200" x="20" y="-64" as="geometry" /></mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontStyle=2" value="Orange = geofluid loop (H2O), teal = secondary R245fa loop. Purple ① ② = where tango and RAFT exchange boundary conditions each pass; grey = how each timestep's passes converge.&#xa;tango sets the loop's mass flow and temperature at the injection wellhead and its pressure at the production wellhead (target_extraction_pressure); RAFT solves for the injection pressure, which the surface plant then delivers." vertex="1"><mxGeometry height="30" width="1700" x="20" y="-40" as="geometry" /></mxCell>
        <mxCell id="c_loop" parent="1" style="rounded=1;dashed=1;fillColor=none;strokeColor=#7D4FB0;verticalAlign=top;fontStyle=1;fontSize=11;align=left;spacingLeft=12;spacingTop=6;strokeWidth=2;" value="grouped_subsurface (variant raft) — idx 0 — RaftGroupedSubsurface" vertex="1"><mxGeometry height="300" width="500" x="20" y="10" as="geometry" /></mxCell>
        <mxCell id="c_inj" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3C4550;fontSize=10;fontStyle=1" value="injection_well&#xa;(WellSegment: geometry)" vertex="1"><mxGeometry height="60" width="130" x="40" y="50" as="geometry" /></mxCell>
        <mxCell id="c_hor" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3C4550;fontSize=10;fontStyle=1" value="horizontal_well&#xa;(WellSegment)" vertex="1"><mxGeometry height="60" width="140" x="190" y="80" as="geometry" /></mxCell>
        <mxCell id="c_prod" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3C4550;fontSize=10;fontStyle=1" value="production_well&#xa;(WellSegment)" vertex="1"><mxGeometry height="60" width="150" x="350" y="50" as="geometry" /></mxCell>
        <mxCell id="oe1" edge="1" parent="1" source="c_inj" target="c_hor" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#C1501F;strokeWidth=2;html=1;endArrow=block;endFill=1;fontSize=9;fontColor=#C1501F;exitX=1;exitY=0.5;entryX=0;entryY=0.5" value=""><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell>
        <mxCell id="oe2" edge="1" parent="1" source="c_hor" target="c_prod" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#C1501F;strokeWidth=2;html=1;endArrow=block;endFill=1;fontSize=9;fontColor=#C1501F;exitX=1;exitY=0.5;entryX=0;entryY=0.5" value=""><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell>
        <mxCell id="c_raft" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EDF9;strokeColor=#7D4FB0;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" value="RAFT — geg_raft.api.RaftModel (raft: block → RaftWrapper)&#xa;one well + surrounding 3D rock, finite elements; template templates/raft/ (NR_tol 1e-8)&#xa;solve(): one trial per injection-enthalpy iteration, from RAFT's accepted state&#xa;get_fresh(): accept the last trial, once per timestep&#xa;records: inlet/outlet values, solve_stats, well_profiles()" vertex="1"><mxGeometry height="120" width="460" x="40" y="170" as="geometry" /></mxCell>
        <mxCell id="c_plant" parent="1" style="rounded=1;dashed=1;fillColor=none;strokeColor=#999C98;verticalAlign=top;fontStyle=1;fontSize=11;align=left;spacingLeft=12;spacingTop=6;strokeWidth=2;" value="surface (GraphSurface) — idx 1 — power_plant.nodes/edges" vertex="1"><mxGeometry height="405" width="1181.7" x="540" y="10" as="geometry" /></mxCell>
        <mxCell id="p_inlet" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3C4550;fontSize=11" value="inlet&#xa;(Source)" vertex="1"><mxGeometry height="45" width="69" x="565.5" y="54.5" as="geometry" /></mxCell>
        <mxCell id="p_evaporator" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3C4550;fontSize=10;fontStyle=1" value="evaporator&#xa;(HeatExchanger)&#xa;ttd_l=7, pr1/pr2=1.0" vertex="1"><mxGeometry height="52.5" width="134" x="673.0" y="50.75" as="geometry" /></mxCell>
