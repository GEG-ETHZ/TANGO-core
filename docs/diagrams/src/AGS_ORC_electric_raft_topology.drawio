        <mxCell id="e9" edge="1" parent="1" source="p_orc_desuperheater" target="p_orc_condenser" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#21787A;strokeWidth=2;html=1;endArrow=block;endFill=1;fontSize=9;fontColor=#21787A;exitX=1;exitY=0.5;entryX=0;entryY=0.5" value=""><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell>
        <mxCell id="e10" edge="1" parent="1" source="p_orc_condenser" target="p_orc_feed_pump" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#21787A;strokeWidth=2;html=1;endArrow=block;endFill=1;fontSize=9;fontColor=#21787A;exitX=1;exitY=0.5;entryX=0;entryY=0.5" value=""><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell>
        <mxCell id="e11" edge="1" parent="1" source="p_orc_feed_pump" target="p_orc_cycle_closer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#21787A;strokeWidth=2;html=1;endArrow=block;endFill=1;fontSize=9;fontColor=#21787A;exitX=1;exitY=0.5;entryX=0;entryY=0.5" value=""><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell>
        <mxCell id="leg_secondary" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#21787A;fontSize=10;fontStyle=1" value="secondary loop (fluid_out2: R245fa)" vertex="1"><mxGeometry height="18" width="260" x="580" y="335" as="geometry" /></mxCell>
        <mxCell id="oe3" edge="1" parent="1" source="c_prod" target="p_inlet" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#C1501F;strokeWidth=2;html=1;endArrow=block;endFill=1;fontSize=9;fontColor=#C1501F;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontStyle=1;fontColor=#7D4FB0" value="②"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell>
        <mxCell id="e_return" edge="1" parent="1" source="p_outlet" target="c_inj" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#C1501F;strokeWidth=2;html=1;endArrow=block;endFill=1;fontSize=9;fontColor=#C1501F;exitX=0.5;exitY=1;entryX=0;entryY=0.5;dashed=1;fontStyle=1;fontColor=#7D4FB0" value="① surface.outlet (h, P_inj) → grouped_subsurface inlet, next pass"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="0" as="offset" /><Array as="points"><mxPoint x="1663.7" y="590" /><mxPoint x="10" y="590" /><mxPoint x="10" y="80" /></Array></mxGeometry></mxCell>
        <mxCell id="m1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontColor=#7D4FB0;fontSize=11;fontStyle=1" value="①" vertex="1"><mxGeometry height="18" width="24" x="12" y="58" as="geometry" /></mxCell>
        <mxCell id="bc1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EDF9;strokeColor=#7D4FB0;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" value="① Injection wellhead (RAFT's well inlet)&#xa;tango → RAFT: mass flow = sim_config.mass_rate (flux BC); temperature from the surface outlet's h at the last P_inj (temperature BC)&#xa;RAFT → tango: P_inj, the injection pressure RAFT solves for&#xa;→ SystemBCIteration calls surface.set_injection_pressure(P_inj) right after the loop solves, so circulation_control delivers it in the same pass" vertex="1"><mxGeometry height="118" width="360" x="20" y="440" as="geometry" /></mxCell>
        <mxCell id="bc2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EDF9;strokeColor=#7D4FB0;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" value="② Production wellhead (RAFT's well outlet)&#xa;tango → RAFT: pressure = sim_config.target_extraction_pressure (pressure BC)&#xa;RAFT → tango: T_out (→ h_out with tango's fluid properties) and the outlet mass flow&#xa;→ the loop's outlet stream (h_out, P = target, mass_rate) is the surface plant's inlet" vertex="1"><mxGeometry height="118" width="360" x="400" y="440" as="geometry" /></mxCell>
        <mxCell id="conv" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#5F6368;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" value="Each timestep (SystemBCIteration)&#xa;1. restore every component to the end of the previous timestep&#xa;2. one pass: grouped_subsurface (one RAFT trial; ① ②), then the surface plant&#xa;3. converged when the surface outlet's h matches the h the loop solved from (|Δh| &lt; 1 kJ/kg) and P_inj has settled (|ΔP| &lt; 1 kPa); else Aitken-relaxed h, next pass (up to 20)&#xa;4. accept: RAFT keeps the last trial (get_fresh), everything is recorded" vertex="1"><mxGeometry height="118" width="520" x="780" y="440" as="geometry" /></mxCell>
        <mxCell id="l_conv" edge="1" parent="1" source="conv" target="p_outlet" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#5F6368;strokeWidth=1.5;dashed=1;dashPattern=2 3;html=1;endArrow=oval;endFill=1;exitX=1;exitY=0.2;entryX=0.5;entryY=1" value=""><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="0" as="offset" /><Array as="points"><mxPoint x="1663.7" y="464" /></Array></mxGeometry></mxCell>
