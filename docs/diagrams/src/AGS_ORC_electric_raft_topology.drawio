        <mxCell id="e4" edge="1" parent="1" source="p_circulation_control" target="p_outlet" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#C1501F;strokeWidth=2;html=1;endArrow=block;endFill=1;fontSize=9;fontColor=#C1501F;exitX=1;exitY=0.5;entryX=0;entryY=0.5" value=""><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell>
        <mxCell id="e5" edge="1" parent="1" source="p_orc_cycle_closer" target="p_preheater" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#21787A;strokeWidth=2;html=1;endArrow=block;endFill=1;fontSize=9;fontColor=#21787A;exitX=0.5;exitY=0;entryX=0.7;entryY=1" value="in2"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="-10" as="offset" /><Array as="points"><mxPoint x="1548.2" y="210" /><mxPoint x="1011.4" y="210" /></Array></mxGeometry></mxCell>
