<mxfile host="app.diagrams.net">
  <diagram name="New Module Structure" id="phase1-module-structure">
    <mxGraphModel dx="1034" dy="546" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1000" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Phase 1 — Parallel Module Structure" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="15" width="940" height="28" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="New code built alongside old — both present until refactored code verified against baseline, then old pruned from main" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="43" width="940" height="18" as="geometry" />
        </mxCell>

        <!-- LEFT: Old structure -->
        <mxCell id="lhdr" value="src/tango/  — OLD (frozen; no changes during Phase 1)" style="text;html=1;strokeColor=#aaaaaa;fillColor=#f5f5f5;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="20" y="72" width="390" height="28" as="geometry" />
        </mxCell>

        <mxCell id="old_tree" value="tango/&lt;br&gt;├── tango_cli.py&lt;br&gt;├── runner.py&lt;br&gt;├── core/&lt;br&gt;│   ├── fluidstate.py&lt;br&gt;│   ├── stream.py&lt;br&gt;│   └── abstracts/&lt;br&gt;│       ├── unit.py        &lt;i&gt;# Unit (ABC)&lt;/i&gt;&lt;br&gt;│       └── orchestrator.py  &lt;i&gt;# UnitManager (ABC)&lt;/i&gt;&lt;br&gt;├── orchestrators/&lt;br&gt;│   ├── native.py          &lt;i&gt;# SystemNative&lt;/i&gt;&lt;br&gt;│   └── external.py        &lt;i&gt;# SystemExternal&lt;/i&gt;&lt;br&gt;├── units/&lt;br&gt;│   ├── registry.py        &lt;i&gt;# UNIT_OPTIONS&lt;/i&gt;&lt;br&gt;│   ├── dataclasses.py     &lt;i&gt;# WellSpecsNative, ...&lt;/i&gt;&lt;br&gt;│   └── native/&lt;br&gt;│       ├── well/&lt;br&gt;│       │   ├── base.py&lt;br&gt;│       │   ├── injection_well.py&lt;br&gt;│       │   ├── production_well.py&lt;br&gt;│       │   └── production_well_pump.py&lt;br&gt;│       ├── reservoir.py&lt;br&gt;│       ├── surface/&lt;br&gt;│       │   ├── flexible_pp.py&lt;br&gt;│       │   ├── ORC.py&lt;br&gt;│       │   └── CPG.py&lt;br&gt;│       └── economic/&lt;br&gt;└── workflows/&lt;br&gt;    └── native_workflow.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#aaaaaa;fontColor=#888888;fontSize=11;align=left;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="20" y="108" width="370" height="460" as="geometry" />
        </mxCell>

        <mxCell id="old_issues" value="⚠  specs = untyped dict throughout (no encapsulation)&lt;br&gt;⚠  mypy fails; ruff warnings present&lt;br&gt;⚠  Input structure ≠ code structure&lt;br&gt;⚠  No changes made here during Phase 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#aaaaaa;fontColor=#888888;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="20" y="578" width="370" height="70" as="geometry" />
        </mxCell>

        <!-- Prune note -->
        <mxCell id="prune" value="Pruned from main after Phase 3 verification completes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="290" height="28" as="geometry" />
        </mxCell>

        <!-- Middle annotation -->
        <mxCell id="mid1" value="↔" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=30;fontColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="404" y="260" width="80" height="50" as="geometry" />
        </mxCell>
        <mxCell id="mid2" value="Build alongside.&lt;br&gt;Verify both produce&lt;br&gt;identical results." style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontColor=#2d7a2d;" vertex="1" parent="1">
          <mxGeometry x="396" y="318" width="95" height="55" as="geometry" />
        </mxCell>
        <mxCell id="mid3" value="One-way&lt;br&gt;migration tool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="388" width="90" height="40" as="geometry" />
        </mxCell>

        <!-- RIGHT: New structure -->
        <mxCell id="rhdr" value="src/tango_next/  — NEW (Phase 1 build target)" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="506" y="72" width="474" height="28" as="geometry" />
        </mxCell>

        <mxCell id="new_tree" value="tango_next/&lt;br&gt;├── tango_cli.py  &lt;i&gt;# reads new input format&lt;/i&gt;&lt;br&gt;├── runner.py&lt;br&gt;├── core/&lt;br&gt;│   ├── fluidstate.py  &lt;i&gt;# unchanged (reuse)&lt;/i&gt;&lt;br&gt;│   ├── stream.py      &lt;i&gt;# unchanged (reuse)&lt;/i&gt;&lt;br&gt;│   └── abstracts/&lt;br&gt;│       ├── unit.py        &lt;i&gt;# typed specs, Pydantic-ready&lt;/i&gt;&lt;br&gt;│       └── orchestrator.py  &lt;i&gt;# typed init&lt;/i&gt;&lt;br&gt;├── orchestrators/&lt;br&gt;│   ├── native.py          &lt;i&gt;# typed specs&lt;/i&gt;&lt;br&gt;│   └── external.py&lt;br&gt;├── units/&lt;br&gt;│   ├── registry.py&lt;br&gt;│   ├── dataclasses.py     &lt;i&gt;# ComponentSpec base class&lt;/i&gt;&lt;br&gt;│   └── native/&lt;br&gt;│       ├── well/&lt;br&gt;│       │   ├── base.py    &lt;i&gt;# __init__ reads typed spec, not dict&lt;/i&gt;&lt;br&gt;│       │   ├── injection_well.py&lt;br&gt;│       │   ├── production_well.py&lt;br&gt;│       │   └── production_well_pump.py&lt;br&gt;│       ├── reservoir.py&lt;br&gt;│       ├── surface/&lt;br&gt;│       │   ├── flexible_pp.py&lt;br&gt;│       │   └── ...&lt;br&gt;│       └── economic/&lt;br&gt;└── workflows/&lt;br&gt;    └── native_workflow.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="506" y="108" width="454" height="460" as="geometry" />
        </mxCell>

        <mxCell id="new_props" value="✓  mypy --strict passes from first commit&lt;br&gt;✓  ruff passes from first commit&lt;br&gt;✓  Components read typed specs, not raw dicts&lt;br&gt;✓  Input file structure mirrors code structure&lt;br&gt;✓  Unit tests can run any component in isolation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="506" y="578" width="454" height="78" as="geometry" />
        </mxCell>

        <!-- Phase 1 end state -->
        <mxCell id="p1end" value="End of Phase 1: tango_next runs flexible_SF_manual.yml (new format) and produces results matching tango baseline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="20" y="710" width="960" height="32" as="geometry" />
        </mxCell>

        <!-- Note about tango_next name -->
        <mxCell id="name_note" value="Note: &apos;tango_next&apos; is a working name — exact directory/package name TBD" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
