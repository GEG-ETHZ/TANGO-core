<mxfile host="Electron">
  <diagram name="CO2_AGS_electric topology" id="co2-ags-electric-topology">
    <mxGraphModel dx="1919" dy="1454" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1438" pageHeight="290" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=15;fontStyle=1" value="CO2_AGS_electric.yml — direct CO2 turbine surface plant topology" vertex="1"><mxGeometry height="24" width="900" x="20" y="-64" as="geometry" /></mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontStyle=2" value="Boxes are TESPy nodes (power_plant.nodes); arrows are power_plant.edges. Closed loop, no reservoir: the fluid stays in the wells and picks up heat along horizontal_well.&#xa;Single fluid loop (CO2, common.fluid_name) throughout -- CO2 expands in the turbine, condenses at 6.0 MPa, then circulation_control restores injection_pressure. Neither well has a downhole pump, so circulation_control (PumpOrValve) is the loop&#x27;s only pressure source: a throttle when the thermosiphon surplus exceeds injection_pressure, a pump when it falls short." vertex="1"><mxGeometry height="30" width="1100" x="20" y="-40" as="geometry" /></mxCell>
        <mxCell id="c_plant" parent="1" style="rounded=1;dashed=1;fillColor=none;strokeColor=#999C98;verticalAlign=top;fontStyle=1;fontSize=11;align=left;spacingLeft=12;spacingTop=6;strokeWidth=2;" value="surface (GraphSurface) — idx 3 — power_plant.nodes/edges" vertex="1"><mxGeometry height="220" width="878" x="540" y="10" as="geometry" /></mxCell>
        <mxCell id="p_inlet" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3C4550;fontSize=11" value="inlet&#xa;(Source)" vertex="1"><mxGeometry height="45" width="69" x="560" y="47.5" as="geometry" /></mxCell>
        <mxCell id="p_turbine" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3C4550;fontSize=10;fontStyle=1" value="turbine&#xa;(Turbine)&#xa;role: net_electric, p_out=6.0 MPa" vertex="1"><mxGeometry height="52.5" width="209" x="674" y="43.75" as="geometry" /></mxCell>
        <mxCell id="p_condenser" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3C4550;fontSize=10;fontStyle=1" value="condenser&#xa;(SimpleHeatExchanger)&#xa;p_out=6.0 MPa, subcooling_K=3" vertex="1"><mxGeometry height="52.5" width="186" x="928" y="43.75" as="geometry" /></mxCell>
        <mxCell id="p_circulation_control" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3C4550;fontSize=10;fontStyle=1" value="circulation_control&#xa;(PumpOrValve)&#xa;role: net_electric" vertex="1"><mxGeometry height="52.5" width="128" x="1159" y="43.75" as="geometry" /></mxCell>
        <mxCell id="p_outlet" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3C4550;fontSize=11" value="outlet&#xa;(Sink)" vertex="1"><mxGeometry height="45" width="56" x="1332" y="47.5" as="geometry" /></mxCell>
