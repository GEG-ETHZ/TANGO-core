        <mxCell id="e3" edge="1" parent="1" source="p_condenser" target="p_circulation_control" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#C1501F;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;endArrow=block;endFill=1"><mxGeometry relative="1" x="0" as="geometry"><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell>
