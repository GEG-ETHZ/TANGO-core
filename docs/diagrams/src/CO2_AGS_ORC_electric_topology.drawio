        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=15;fontStyle=1" value="CO2_AGS_ORC_electric.yml — binary (ORC) surface plant topology" vertex="1"><mxGeometry height="24" width="900" x="20" y="-64" as="geometry" /></mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontStyle=2" value="Boxes are TESPy nodes (power_plant.nodes); arrows are power_plant.edges. Closed loop, no reservoir: the fluid stays in the wells and picks up heat along horizontal_well.&#xa;Orange = geofluid loop (CO2, common.fluid_name), teal = secondary/R245fa loop -- the two never mix, only exchange heat at evaporator/preheater. Neither well has a downhole pump, so circulation_control (PumpOrValve) is the loop&#x27;s only pressure source: a throttle when the thermosiphon surplus exceeds injection_pressure, a pump when it falls short." vertex="1"><mxGeometry height="30" width="1100" x="20" y="-40" as="geometry" /></mxCell>
        <mxCell id="c_plant" parent="1" style="rounded=1;dashed=1;fillColor=none;strokeColor=#999C98;verticalAlign=top;fontStyle=1;fontSize=11;align=left;spacingLeft=12;spacingTop=6;strokeWidth=2;" value="surface (GraphSurface) — idx 3 — power_plant.nodes/edges" vertex="1"><mxGeometry height="405" width="1196.7" x="540" y="10" as="geometry" /></mxCell>
