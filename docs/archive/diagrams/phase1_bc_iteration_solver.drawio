        <mxCell id="flow_rate_mode_legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=left;" value="&lt;b&gt;InjectionPolicy&lt;/b&gt;  (sim_config.injection_mode)&lt;br&gt;─────────────────────────────────────────────────────&lt;br&gt;&lt;b&gt;manual&lt;/b&gt;                user rate + user P; no fracking check; single pass&lt;br&gt;&lt;b&gt;manual-fracking-check&lt;/b&gt;  user rate + user P; violations → error; single pass&lt;br&gt;&lt;b&gt;auto-pressure&lt;/b&gt;         user rate; P iterated; flow fracking → error&lt;br&gt;&lt;b&gt;auto-flow&lt;/b&gt;             user P; rate → fracking_flow(); pressure fracking → error&lt;br&gt;&lt;b&gt;auto-both&lt;/b&gt;             both iterated; rate reduced if no feasible P&lt;br&gt;─────────────────────────────────────────────────────&lt;br&gt;&lt;i&gt;Planned: max-net-power, min-lcoe (Phase 2+)&lt;/i&gt;" vertex="1">
          <mxGeometry height="140" width="490" x="710" y="663" as="geometry" />
