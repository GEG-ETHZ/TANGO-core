<mxfile host="Electron">
  <diagram name="Phase 1 BC Iteration Solver" id="phase1-bc-iter-solver">
    <mxGraphModel dx="1719" dy="1040" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1200" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontStyle=1;" value="BC Iteration Solver — Phase 2 target design  [src/tango/ ref: FlowRateCalculator.iterator]" vertex="1">
          <mxGeometry height="22" width="1160" x="20" y="4" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;fontStyle=2;" value="(flexible_SF_manual.yml — SystemBCIteration, auto-selected when sim_config.injection_mode is present)" vertex="1">
          <mxGeometry height="16" width="1160" x="20" y="26" as="geometry" />
        </mxCell>
        <mxCell id="lbl_outer" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontStyle=1;fontColor=#555555;" value="SystemBCIteration.run_timestep(t)    [src/tango/: FlowRateCalculator.iterator]" vertex="1">
          <mxGeometry height="16" width="450" x="20" y="46" as="geometry" />
        </mxCell>
        <mxCell id="start" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Begin timestep t" vertex="1">
          <mxGeometry height="40" width="200" x="80" y="66" as="geometry" />
        </mxCell>
        <mxCell id="seed" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="_seed_surface_inlet()&#xa;seeds mass_rate + T on first call only (mass_rate==0.0 default)&#xa;test_p = spec.injection_pressure  ← one-time init before loop" vertex="1">
          <mxGeometry height="72" width="300" x="30" y="120" as="geometry" />
        </mxCell>
        <mxCell id="loop_lbl" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=9;fontStyle=3;" value="for bc_iter in range(max_iterations):" vertex="1">
          <mxGeometry height="16" width="290" x="10" y="202" as="geometry" />
        </mxCell>
        <mxCell id="c_inj" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="①  injection_well  (idx=0)&#xa;inlet.P = test_p   inlet.T = surface.outlet.T&#xa;LumpedInjectionWell.solve()" vertex="1">
          <mxGeometry height="56" width="320" x="20" y="224" as="geometry" />
        </mxCell>
        <mxCell id="update_testp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=0;" value="test_p += target_reservoir_P − inj_well.outlet.P&#xa;target_reservoir_P = hydrostatic_P × (1 + overpressure%/100)&#xa;(src/tango/ MANUAL_FRACKING_CHECK: skip if target_reservoir_P &amp;gt; inj_well.outlet.P —&#xa;reservoir inlet is below fracking threshold; no pressure adjustment needed)" vertex="1">
          <mxGeometry height="102" width="320" x="20" y="298" as="geometry" />
        </mxCell>
        <mxCell id="c_res" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="②  reservoir  (idx=1)&#xa;LumpedReservoir.solve()&#xa;inlet ← inj_well.outlet" vertex="1">
          <mxGeometry height="52" width="320" x="20" y="428" as="geometry" />
        </mxCell>
        <mxCell id="c_pwl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="③  production_well_lower  (idx=2)&#xa;LumpedProductionWell.solve()&#xa;inlet ← reservoir.outlet" vertex="1">
          <mxGeometry height="52" width="320" x="20" y="496" as="geometry" />
        </mxCell>
        <mxCell id="c_pwu" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="④  production_well_upper  (idx=3)&#xa;LumpedProductionWellPump.solve()  [inner loop]&#xa;iterate pump_dp until outlet.P ≈ target_extraction_P" vertex="1">
          <mxGeometry height="56" width="320" x="20" y="564" as="geometry" />
        </mxCell>
        <mxCell id="c_surf" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="⑤  surface  (idx=4)&#xa;GraphSurface.solve()&#xa;inlet ← pro_well_pump.outlet  (P ≈ target_extraction_P)" vertex="1">
          <mxGeometry height="52" width="320" x="20" y="636" as="geometry" />
        </mxCell>
        <mxCell id="conv_lbl" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=9;fontStyle=2;" value="AUTO_PRESSURE / AUTO_FLOW / AUTO_BOTH only  (see ★)" vertex="1">
          <mxGeometry height="14" width="280" x="184" y="688" as="geometry" />
        </mxCell>
        <mxCell id="conv" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="|test_p[N] − test_p[N-1]| / test_p[N-1] &lt; tol ?&#xa;(also: mass_rate)  ★" vertex="1">
          <mxGeometry height="97" width="310" x="25" y="718" as="geometry" />
        </mxCell>
        <mxCell id="done" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Converged ✓   break" vertex="1">
          <mxGeometry height="40" width="200" x="80" y="866" as="geometry" />
        </mxCell>
        <mxCell id="next_iter" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="prev_test_p = test_p&#xa;next bc_iter" vertex="1">
          <mxGeometry height="48" width="180" x="490" y="700" as="geometry" />
        </mxCell>
        <mxCell id="e_start_seed" edge="1" parent="1" source="start" style="edgeStyle=orthogonalEdgeStyle;" target="seed">
