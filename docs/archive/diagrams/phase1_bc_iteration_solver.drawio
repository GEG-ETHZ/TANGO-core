          </mxGeometry>
        </mxCell>
        <mxCell id="e_res_pwl" edge="1" parent="1" source="c_res" style="edgeStyle=orthogonalEdgeStyle;" target="c_pwl">
          <mxGeometry relative="1" as="geometry" />
