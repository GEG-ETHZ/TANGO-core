        <mxCell id="e_T_feedback" edge="1" parent="1" source="c_surf" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#999999;exitX=1;exitY=0.5;exitDX=0;exitDY=0;entryX=1;entryY=0.5;entryDX=0;entryDY=0;" target="c_inj">
          <mxGeometry relative="1" as="geometry">
