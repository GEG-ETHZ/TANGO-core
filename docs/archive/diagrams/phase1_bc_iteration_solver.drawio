          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_update_res" edge="1" parent="1" source="update_testp" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="c_res">
          <mxGeometry relative="1" as="geometry">
