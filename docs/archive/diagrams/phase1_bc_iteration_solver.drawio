        <mxCell id="e_T_lbl" connectable="0" parent="e_T_feedback" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontStyle=2;" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;surface.outlet.T → next iter inlet.T&lt;/font&gt;" vertex="1">
          <mxGeometry relative="1" x="0.5" as="geometry">
            <mxPoint x="-96" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="phase2_note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=9;align=left;" value="★  InjectionPolicy governs iteration (see legend →)&lt;br&gt;&lt;br&gt;  MANUAL / MANUAL_FRACKING_CHECK:&lt;br&gt;    single pass; break immediately after ⑤&lt;br&gt;&lt;br&gt;  AUTO_PRESSURE / AUTO_FLOW / AUTO_BOTH:&lt;br&gt;    loop until convergence diamond is satisfied&lt;br&gt;&lt;br&gt;  src/tango/: one loop body for all modes;&lt;br&gt;  MANUAL_FRACKING_CHECK uses the &quot;skip if&lt;br&gt;  target &amp;gt; outlet.P&quot; shortcut in the update box.&lt;br&gt;&lt;br&gt;Phase 1 status: trivially converges in 1 pass.&lt;br&gt;  surface.outlet.P = self.injection_pressure always,&lt;br&gt;  so |Δtest_p| = 0." vertex="1">
          <mxGeometry height="210" width="300" x="330" y="770" as="geometry" />
        </mxCell>
        <mxCell id="pump_inner" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;" value="Inner pump loop (src/tango/: 5 fixed iterations):&#xa;  pump_dp = max(0, ρgL − pro_well.outlet.P)&#xa;  for i in range(5):&#xa;    pump_inlet.P = pro_well.outlet.P + pump_dp&#xa;    pro_well_pump.stream_interface()&#xa;    pump_dp += target_extraction_P − pump.outlet.P&#xa;    if pump.outlet.P ≈ target_extraction_P: break&#xa;Phase 2: replace with convergence-based loop." vertex="1">
          <mxGeometry height="110" width="290" x="620" y="530" as="geometry" />
        </mxCell>
        <mxCell id="e_pwu_callout" edge="1" parent="1" source="c_pwu" style="edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=1;exitY=0.5;exitDX=0;exitDY=0;entryX=0;entryY=0.5;entryDX=0;entryDY=0;" target="pump_inner">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="460" y="567" />
              <mxPoint x="460" y="585" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="pp" parent="1" style="swimlane;startSize=48;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;fontStyle=1;" value="GraphSurface — power_plant sub-graph&#xa;(generic TESPy network built from power_plant.nodes/edges YAML — implemented)" vertex="1">
