        <mxCell id="wf_note" parent="wf_layer" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontStyle=2;fontColor=#888888;align=left;verticalAlign=top;" value="Top-level entry point: parses the YAML input file, builds the component graph, and selects the orchestrator — SystemDirect vs SystemBCIteration — &lt;br&gt;based on whether sim_config.injection_mode is present. Contains: Workflow." vertex="1">
          <mxGeometry height="44" width="640" x="160" y="25" as="geometry" />
        </mxCell>
        <mxCell id="orch_layer" parent="1" style="swimlane;startSize=22;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" value="orchestrators/" vertex="1">
          <mxGeometry height="135" width="820" x="40" y="213" as="geometry" />
        </mxCell>
        <mxCell id="sys_direct" parent="orch_layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" value="SystemDirect" vertex="1">
          <mxGeometry height="22" width="155" x="10" y="25" as="geometry" />
        </mxCell>
        <mxCell id="sys_bciter" parent="orch_layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" value="SystemBCIteration" vertex="1">
          <mxGeometry height="22" width="180" x="175" y="25" as="geometry" />
        </mxCell>
        <mxCell id="orch_note" parent="orch_layer" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;fontStyle=2;fontColor=#888888;align=left;verticalAlign=top;" value="Drives the per-timestep solve loop over the instantiated component graph. SystemDirect owns the only&lt;br&gt;implementation of &quot;one circuit pass&quot; and &quot;loop over timesteps&quot; — no BC search. SystemBCIteration subclasses&lt;br&gt;SystemDirect and reuses both via inheritance, adding BC seeding and an outer convergence loop governed by&lt;br&gt;InjectionPolicy (Newton-step iteration, convergence + max-iteration checks). Choosing SystemDirect vs&lt;br&gt;SystemBCIteration is a topology question (does the graph declare a BC-iteration circuit at all) — InjectionPolicy&lt;br&gt;never affects which class is picked, only how many passes a timestep takes. External simulator hooks (CMG,&lt;br&gt;MOOSE) are composable add-ons — socket placement TBD (see vision doc). Future: a GroupedComponent&#39;s&lt;br&gt;inner graph recursively selects its own orchestrator (Direct vs BCIteration) by the same topology check." vertex="1">
          <mxGeometry height="100" width="445" x="365" y="25" as="geometry" />
        </mxCell>
        <mxCell id="comp_layer" parent="1" style="swimlane;startSize=22;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" value="components/" vertex="1">
