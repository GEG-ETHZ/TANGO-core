{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
        },
        {
            "name": "Python: hydro_double_flash_electric.yml",
            "type": "debugpy",
            "request": "launch",
            "program": "tango_next_cli",
            "args": [
                "examples/tango_next/hydro_double_flash_electric.yml"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Python: AGS_H2O_webapp_native_direct_heat.yml (old tango)",
            "type": "debugpy",
            "request": "launch",
            "module": "tango.tango_cli",
            "args": [
                "-f",
                "examples/AGS_new/AGS_H2O_webapp_native_direct_heat.yml"
            ],
            "console": "integratedTerminal"
        }
    ]
}
