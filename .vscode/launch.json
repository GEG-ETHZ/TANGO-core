{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
        },
        {
            "name": "Python: hydro_df_electric.yml",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "program": "${workspaceFolder}/.venv/bin/tango_core",
            "args": [
                "run",
                "templates/hydro_df_electric.yml",
                "--no-save"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Python: AGS_H2O_webapp_native.yml (old tango)",
            "type": "debugpy",
            "request": "launch",
            "module": "tango_core.cli",
            "args": [
                "-f",
                "examples/AGS_new/AGS_H2O_webapp_native.yml"
            ],
            "console": "integratedTerminal"
        }
    ]
}
