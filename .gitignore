htmlcov/*
.coverage
.coverage.*
.tox
junit*.xml
coverage.xml
.pytest_cache/

# Build and docs folder/files
build/*
dist/*
sdist/*
docs/api/*
docs/_rst/*
docs/_build/*
cover/*
MANIFEST

# Per-project virtualenvs
.venv*/
.conda*/
.python-version
.pixi/

# Claude Code memory
memory/
.claude/

# draw.io autosave/crash-recovery files
dev_docs/diagrams/src/.$*.bkp
docs/diagrams/src/.$*.bkp

# Configuration and secrets
*.env
secrets/

# gitlab runner artefacts
cache
builds

# Images
*.png
*.svg
# Only images that a markdown doc embeds are tracked. Diagram exports are
# regenerated from dev_docs/diagrams/src/ and docs/diagrams/src/ *.drawio, so
# anything not embedded stays local -- except docs/diagrams/*.svg, the
# user-facing topology diagrams written by `just diagrams` (GitHub and Sphinx
# both render SVG).
!docs/diagrams/*.svg
!dev_docs/diagrams/img/t_convergence_circuit.png
!dev_docs/diagrams/img/t_convergence_loop.png
!dev_docs/diagrams/img/cos_converge_example.png
!dev_docs/diagrams/img/mass_rate_profiles.png
.aider*
.claude/
*.drawio.bkp

# Local run output, e.g. from `just phase-diagrams`
scratch_output/

# Root-level scratch markdown (planning notes, worklogs) — not meant to be
# tracked; repo-root only, doesn't affect docs/ etc. Existing tracked
# root .md files are explicitly excepted below.
/*.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/README.md

# Study runs that never go through DVC, e.g. tools/n_max_gen_study_job.sh
studies/
