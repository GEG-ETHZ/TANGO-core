# Temporary and binary files
*~
*.py[cod]
*.so
*.cfg
!.isort.cfg
*.orig
*.log
*.pot
*.prof
__pycache__/*
.cache/*
.*.swp
*/.ipynb_checkpoints/*
.DS_Store
# Per-developer direnv settings (see .envrc)
.envrc.local

# Project files
.ropeproject
.project
.pydevproject
.settings
.idea
tags

# Package files
*.egg
*.eggs/
.installed.cfg
*.egg-info

# Unittest and coverage
htmlcov/*
.coverage
.coverage.*
.tox
junit*.xml
coverage.xml
.pytest_cache/

# Build and docs folder/files
build/*
dist/*
sdist/*
docs/api/*
docs/_rst/*
docs/_build/*
cover/*
MANIFEST

# Per-project virtualenvs
.venv*/
.conda*/
.python-version
.pixi/

# Claude Code memory
memory/
.claude/

# draw.io autosave/crash-recovery files
docs/diagrams/src/.$*.bkp
docs/archive/diagrams/.$*.bkp

# Configuration and secrets
*.env
secrets/

# CI runner artifacts
cache
builds

# Images
*.png
*.svg
# Only images that a markdown doc embeds are tracked; other diagram exports
# stay local. docs/diagrams/*.svg are the topology diagrams that
# `just diagrams` exports from docs/diagrams/src/*.drawio.
!docs/diagrams/*.svg
!docs/diagrams/img/**/*.svg
# README banner and hero (tools/readme_assets.py) and editable hero diagrams
!/docs/assets/*.svg
!/docs/diagrams/*.drawio.svg
!docs/diagrams/img/**/*.png
.aider*
.claude/
*.drawio.bkp

# Local run output, e.g. from `just phase-diagrams`
scratch_output/

# Root-level scratch markdown (planning notes, worklogs) — not meant to be
# tracked; repo-root only, doesn't affect docs/ etc. Existing tracked
# root .md files are explicitly excepted below.
/*.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/GEMINI.md
!/SECURITY.md

# docs site build output (zensical build)
/site/

# Docs site build output, internal preview (mkdocs.internal.yml)
/site-internal/

# Study runs that never go through DVC, e.g. tools/n_max_gen_study_job.sh
studies/
