*.orig
*.log
*.pot
*.prof
__pycache__/*
.cache/*
.*.swp
*/.ipynb_checkpoints/*
.DS_Store
# Per-developer direnv settings (see .envrc)
.envrc.local

# Project files
.ropeproject
.project
.pydevproject
.settings
.idea
tags

